# Copy values into a private environment, never into a tracked .env file.
# Leave both credentials blank for the read-only offline synthetic demo.
EGIS_REVIEWER_ID=
EGIS_REVIEW_PASSWORD_HASH=
EGIS_REVIEW_SESSION_SECONDS=900
# Existing owner-protected directory outside the repository, passed as --review-dir.
EGIS_REVIEW_DIR=
# Real Splunk remains disabled and is not used by the W8 demo.
EGIS_REAL_SPLUNK_ENABLED=false
